generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider              = "postgresql"
  url                   = env("DATABASE_URL")
  advisoryLockTimeout   = 60000
}

model Vehicle {
  id           String    @id @default(cuid())
  make         String
  model        String
  year         Int
  price        Float
  mileage      Int
  fuelType     String
  transmission String
  condition    String
  status       String    @default("available")
  images       String    @default("[]")
  description           String
  featured              Boolean   @default(false)
  onlineBookingRefund   Float?
  onlineBookingAmount   Float?
  createdAt             DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  inquiries    Inquiry[]
}

model Service {
  id              String           @id @default(cuid())
  name            String
  description     String
  estimatedPrice  Float
  durationMinutes Int
  imageUrl        String?
  active          Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  bookings        ServiceBooking[]
}

model ServiceBooking {
  id               String   @id @default(cuid())
  customerName     String
  email            String
  phone            String
  customerArea     String
  customerAddress  String?
  latitude         Float?
  longitude        Float?
  vehicleInfo      String
  serviceId        String
  service          Service  @relation(fields: [serviceId], references: [id])
  preferredDate    DateTime
  preferredTime    String
  notes            String?
  status           String   @default("pending")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model ServiceArea {
  id        String   @id @default(cuid())
  name      String
  pinCode   String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ServiceCentreConfig {
  id                 String   @id @default("default")
  latitude           Float
  longitude          Float
  radiusKm           Float    @default(25)
  radiusCheckEnabled Boolean  @default(true)
  label              String   @default("Auto Galaxy Service Centre")
  updatedAt          DateTime @updatedAt
}

model SiteSettings {
  id                String   @id @default("default")
  businessHours     String   @default("[]")
  noticeText        String?
  noticeActive      Boolean  @default(false)
  visitorCount      Int      @default(0)
  showVisitorCount  Boolean  @default(true)
  heroImageUrl      String?
  logoUrl           String?
  defaultOnlineBookingAmount Float?
  updatedAt         DateTime @updatedAt
}

model ServiceScheduleContent {
  id        String   @id @default("default")
  title     String
  summary   String?
  content   String   @db.Text
  published Boolean  @default(true)
  updatedAt DateTime @updatedAt
}

model EsteemedCustomer {
  id           String   @id @default(cuid())
  name         String
  designation  String?
  locality     String?
  vehicle      String?
  note         String?
  photoUrl     String?
  sortOrder    Int      @default(0)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model SiteVisit {
  id        String   @id @default(cuid())
  path      String
  city      String?
  region    String?
  country   String?
  device    String?
  referer   String?
  visitedAt DateTime @default(now())

  @@index([visitedAt])
  @@index([path])
}

model WebVitalsSample {
  id        String   @id @default(cuid())
  name      String
  value     Float
  rating    String
  path      String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([name, createdAt])
}

model Inquiry {
  id        String   @id @default(cuid())
  type      String
  name      String
  email     String
  phone     String?
  message   String
  vehicleId              String?
  vehicle                Vehicle? @relation(fields: [vehicleId], references: [id])
  refundAmountAtBooking  Float?
  bookingAmountAtBooking Float?
  paymentStatus          String   @default("not_required")
  paymentOrderId         String?  @unique
  paymentId              String?
  status                 String   @default("new")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WhatsAppOtp {
  id        String   @id @default(cuid())
  phone     String
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([phone, expiresAt])
}

model UpdateSubscription {
  id               String   @id @default(cuid())
  name             String
  phone            String   @unique
  email            String?
  whatsappVerified Boolean  @default(true)
  verifiedAt       DateTime @default(now())
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         String   @default("admin")
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model JobPosting {
  id             String           @id @default(cuid())
  title          String
  department     String
  location       String
  employmentType String
  description    String
  requirements   String
  salaryRange    String?
  status         String           @default("open")
  active         Boolean          @default(true)
  roleTemplate   String           @default("general")
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  applications   JobApplication[]
}

model JobApplication {
  id                  String                 @id @default(cuid())
  jobId               String
  job                 JobPosting             @relation(fields: [jobId], references: [id], onDelete: Cascade)
  name                String
  email               String
  phone               String?
  resumeUrl           String?
  coverLetter         String?
  status              String                 @default("new")
  trackingCode        String                 @unique
  adminNotes          String?
  screeningResponses  Json?
  evaluationScores    Json?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  activities          ApplicationActivity[]
}

model ApplicationActivity {
  id            String         @id @default(cuid())
  applicationId String
  application   JobApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  type          String
  message       String
  status        String?
  createdBy     String?
  createdAt     DateTime       @default(now())

  @@index([applicationId, createdAt])
}

model ShowroomWalkIn {
  id                   String    @id @default(cuid())
  enquiryDate          DateTime  @db.Date
  name                 String
  requiredModel        String
  contactNumber        String?
  address              String?
  paymentMode          String?
  expectedPurchaseDate DateTime? @db.Date
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([enquiryDate])
}

model CashBoxRecord {
  id             String         @id @default(cuid())
  recordDate     DateTime       @db.Date
  sessionNumber  Int            @default(1)
  openingBalance Float
  takenHome      Float          @default(0)
  notes          String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  entries        CashBoxEntry[]

  @@unique([recordDate, sessionNumber])
  @@index([recordDate])
}

model CashBoxEntry {
  id            String        @id @default(cuid())
  recordId      String
  record        CashBoxRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)
  type          String
  category      String
  business      String?
  paymentMethod String?
  description   String
  amount        Float
  sortOrder     Int           @default(0)
  createdAt     DateTime      @default(now())
}
