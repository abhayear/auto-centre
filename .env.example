# Local development (Docker Postgres)
DATABASE_URL="postgresql://autocentre:autocentre@localhost:5433/autocentre?schema=public"

# Auth (generate with: openssl rand -base64 32)
NEXTAUTH_SECRET="generate-a-secure-random-string"
AUTH_SECRET="generate-a-secure-random-string"
NEXTAUTH_URL="http://localhost:3000"

# Seed script only — do not use weak passwords in production
ADMIN_EMAIL="admin@autogalaxy.in"
ADMIN_PASSWORD="change-me-in-production"

# Google Maps (Places Autocomplete + map on book-service & contact pages)
# Enable: Maps JavaScript API + Places API
# https://console.cloud.google.com/google/maps-apis
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="your-google-maps-api-key"

# Optional: Cloud Vitals AI advisor (OpenAI). Without this, smart rule-based advice is used.
# OPENAI_API_KEY="sk-..."
# OPENAI_MODEL="gpt-4o-mini"

# Vehicle image uploads on Vercel (create a Blob store in Vercel → Storage → connect to project)
# Vercel adds BLOB_STORE_ID (OIDC) or BLOB_READ_WRITE_TOKEN automatically — then redeploy.

# Optional: Razorpay online booking payments (UPI, cards, etc.)
# Create keys at https://dashboard.razorpay.com/app/keys
# RAZORPAY_KEY_ID="rzp_test_..."
# RAZORPAY_KEY_SECRET="your-secret-key"

# Optional: WhatsApp notifications for new job applications (Meta Cloud API)
# Setup: https://developers.facebook.com/docs/whatsapp/cloud-api/get-started
# WHATSAPP_ACCESS_TOKEN="your-meta-access-token"
# WHATSAPP_PHONE_NUMBER_ID="your-whatsapp-business-phone-number-id"
# Comma-separated recipient numbers with country code (defaults to site phones with 91 prefix)
# WHATSAPP_NOTIFY_NUMBERS="919885831851,919809953096"

# Production example (Neon / Supabase / Railway)
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"
# NEXTAUTH_URL="https://your-domain.com"
